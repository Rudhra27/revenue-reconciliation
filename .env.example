# Copy to .env and adjust for your machine. Never commit .env.
# The defaults in application.yml already point at a local database with these values,
# so you only need this file if your setup differs.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reconciler
SPRING_DATASOURCE_USERNAME=reconciler
SPRING_DATASOURCE_PASSWORD=reconciler

# HTTP port (defaults to 8080)
PORT=8080

# Sample data loader (on by default)
APP_SAMPLE_DATA_ENABLED=true

# LLM explanations. Without a key the app still works — the Explain buttons just
# report that the service is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=20
# APP_LLM_ENABLED=false   # force the explanation layer off even if a key is set
# OPENAI_BASE_URL=https://api.openai.com/v1
