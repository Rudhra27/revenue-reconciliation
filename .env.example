# Copy to .env and adjust for your machine. Never commit .env.
# The defaults in application.yml already point at a local database with these values,
# so you only need this file if your setup differs.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reconciler
SPRING_DATASOURCE_USERNAME=reconciler
SPRING_DATASOURCE_PASSWORD=reconciler

# HTTP port (defaults to 8080)
PORT=8080

# Sample data loader (on by default)
APP_SAMPLE_DATA_ENABLED=true

# --- LLM explanations (optional) ---
# Without a key the app still works; the Explain buttons just report that the
# service isn't configured. Any OpenAI-compatible endpoint works.

# OpenAI:
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   LLM_RESPONSE_FORMAT=json_schema      # strict; OpenAI only
#
# Groq (free, OpenAI-compatible; models are reasoning models, so keep the effort low):
#   LLM_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-20b
#   LLM_REASONING_EFFORT=low

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=20
LLM_RESPONSE_FORMAT=json_object          # json_schema | json_object | none
LLM_REASONING_EFFORT=                    # low | medium | high; blank for non-reasoning models
# APP_LLM_ENABLED=false                  # force the explanation layer off even with a key set
